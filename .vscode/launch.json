{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "skripsi-windows",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        },
        {
            "name": "skripsi-web",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome"
                // "--web-browser-flag=--disable-web-security"
            ]
        },
        {
            "name": "skripsi-web (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "-d",
                "chrome"
            ]
        },
        {
            "name": "skripsi-web (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "-d",
                "chrome"
            ]
        }
    ]
}